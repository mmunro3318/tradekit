{
  "description": "`BrokerPort.order_status(order_id)`'s return shape (\u00a78.1).",
  "properties": {
    "order_id": {
      "title": "Order Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "partially_filled",
        "filled",
        "canceled",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "filled_qty": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Filled Qty"
    },
    "remaining_qty": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remaining Qty"
    }
  },
  "required": [
    "order_id",
    "status"
  ],
  "title": "OrderStatus",
  "type": "object"
}